# Supabase (frontend)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# Login com Google: Supabase → Authentication → Providers → Google (Client ID/Secret do Google Cloud).
# Em Authentication → URL Configuration, inclua em Redirect URLs: http://localhost:3000/auth/callback e https://seu-dominio/auth/callback

# API do backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Stripe (chave pública)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# PostHog
NEXT_PUBLIC_POSTHOG_TOKEN=phc...   # Project API Key no PostHog
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com